# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Optional WebSocket relay for "Share -> Relay WebSocket" (live collaboration).
# The app works without it; cloud sync uses Supabase instead.
#
# Build:
#   docker build -f Dockerfile.relay -t whimsical-relay .
# Run:
#   docker run -p 8787:8787 whimsical-relay
# ---------------------------------------------------------------------------

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787

COPY server/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

COPY server/relay.mjs ./relay.mjs

USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8787/health >/dev/null 2>&1 || exit 1

CMD ["node", "relay.mjs"]
