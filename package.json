    "@squinch/pack-gcp": "^0.19.0",
    "@squinch/pack-k8s": "^0.19.0",
    "@squinch/pack-logos": "^0.19.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide": "^1.71.0",
    "mermaid": "^12.3.0",
    "nanoid": "^5.0.7",
