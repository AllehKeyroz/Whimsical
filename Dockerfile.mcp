# syntax=docker/dockerfile:1

# KDS FLUX MCP server (Streamable HTTP).
# Server-side only: this container holds the Supabase service role key.
# Build:
#   docker build -f Dockerfile.mcp -t kds-flux-mcp .
# Run:
#   docker run -p 8788:8788 \
#     -e KDSFLUX_SUPABASE_URL=... \
#     -e KDSFLUX_SUPABASE_SERVICE_ROLE_KEY=... kds-flux-mcp

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
ENV MCP_TRANSPORT=http
ENV MCP_PORT=8788

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund --ignore-scripts

COPY server ./server

USER node
EXPOSE 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8788/health >/dev/null 2>&1 || exit 1

CMD ["node", "server/mcp.mjs"]
