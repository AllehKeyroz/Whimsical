# KDS FLUX MCP server (server-side only)
# Copy to your Easypanel service environment or a local .env for development.
KDSFLUX_SUPABASE_URL=https://your-project.supabase.co
KDSFLUX_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# http (recommended for remote agents) or stdio (local process)
MCP_TRANSPORT=http
MCP_PORT=8788

# Only for MCP_TRANSPORT=stdio:
# KDSFLUX_TOKEN=kdsflux_...
